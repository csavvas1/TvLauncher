<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Wallpaper background (hidden by default) -->
    <ImageView
        android:id="@+id/bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- TOP LEFT: time+date line, weather line -->
    <LinearLayout
        android:id="@+id/info_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_time_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/time_text_size"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.03"
            android:text="22:14  |  Monday 27 October 2026"/>

        <TextView
            android:id="@+id/tv_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/weather_text_size"
            android:fontFamily="sans-serif-light"
            android:layout_marginTop="5dp"
            android:text="⛅ 19°C · Partly Cloudy"/>
    </LinearLayout>

    <!-- TOP RIGHT: wifi + settings buttons -->
    <LinearLayout
        android:id="@+id/quick_icons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingEnd="28dp"
        android:paddingTop="20dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_wifi"
            android:layout_width="@dimen/qi_btn_size"
            android:layout_height="@dimen/qi_btn_size"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_qi_btn"
            android:padding="10dp"
            android:src="@drawable/ic_wifi"
            android:focusable="true"
            android:contentDescription="WiFi"/>

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="@dimen/qi_btn_size"
            android:layout_height="@dimen/qi_btn_size"
            android:background="@drawable/bg_qi_btn"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            android:focusable="true"
            android:contentDescription="Settings"/>
    </LinearLayout>

    <!-- DOCK: island container -->
    <FrameLayout
        android:id="@+id/dock_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dock_margin_h"
        android:layout_marginEnd="@dimen/dock_margin_h"
        android:layout_marginBottom="@dimen/dock_margin_bottom"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Island dark glass pill -->
        <LinearLayout
            android:id="@+id/dock_island"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_dock"
            android:padding="@dimen/dock_padding"/>

        <!-- Animated bezel overlay -->
        <View
            android:id="@+id/bezel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_bezel"
            android:visibility="invisible"/>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
